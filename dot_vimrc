function! CheckTheFileInTabs()
    let file='.vimrc'
	let tab_index = 0

    " Iterate over all tabs
    while tab_index < tabpagenr('$')
        " Switch to tab
        execute tab_index + 1 . "tabnext"
        let tab_id = tabpagenr()

        " Iterate over all windows in the current tab
        let win_index = 0
        while win_index < winnr('$')
            " Switch to window
            execute win_index + 1 . "wincmd w"
            let win_id = win_getid()
            let file_name = expand('%:p')
	    echo tab_id file win_id file_name
            let win_index += 1
        endwhile

        let tab_index += 1
    endwhile

endfunction


"vim enter, mouse mode and exit mouse mode, by key: <C-w>m
let g:mouse_en = 0
function! MouseToggle()
	if g:mouse_en == 0
		let g:mouse_en=1
		set mouse=a
	else
		let g:mouse_en=0
		set mouse=
	endif
endfunction
nnoremap <silent> <C-w>m :call MouseToggle() <CR><C-w>=

